         "\[IndentingNewLine]", 
         RowBox[{"Append", "[", 
          RowBox[{"pVector", ",", "prangeDay"}], "]"}], ";"}]}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
