           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cs", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "maxcr"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Pffs", " ", "=", " ", 
        RowBox[{"getLambda", "[", 
         RowBox[{
          RowBox[{"p0", "/", "k"}], ",", 
          RowBox[{"2", "*", "maxcr"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{"Optimization", " ", "procedure"}], " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"t", "=", "T"}], ",", 
         RowBox[{"t", "\[GreaterEqual]", " ", "1"}], ",", 
         RowBox[{"t", "--"}], ",", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Horizon", " ", "times"}], ",", " ", 
