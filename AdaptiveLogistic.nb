 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"solveLogisticSystem", " ", "[", 
     RowBox[{"pp0_", ",", "tt0_", ",", "tt1_", ",", "kk_", ",", " ", "rr_"}], 
     "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p0", "=", "pp0"}], ",", 
        RowBox[{"t0", "=", "tt0"}], ",", " ", 
        RowBox[{"t1", "=", "tt1"}], ",", 
        RowBox[{"k", "=", "kk"}], ",", 
        RowBox[{"r", "=", "rr"}]}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{"(*", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
        "Logistic", " ", "Growth", " ", "equation", " ", "is", " ", 
         "deterministic", "\n", "    ", "We", " ", "give", " ", "the", " ", 
         "solution", " ", "vector", " ", "betweeen", " ", "t0", " ", "and", 
         " ", 
         RowBox[{"t1", ".", "\n", "    ", "That"}], " ", "is", " ", "we", " ", 
         RowBox[{"return", " ", "[", 
          RowBox[{
           RowBox[{"P", 
            RowBox[{"(", "t0", ")"}]}], ",", " ", 
           RowBox[{"P", 
            RowBox[{"(", "t1", ")"}]}]}], "]"}], " ", "solution", " ", "for", 
         " ", "the", " ", 
         RowBox[{"system", ":", "\[IndentingNewLine]", 
          RowBox[{"dP", "/", "dt"}]}]}], " ", "=", " ", 
        RowBox[{
         RowBox[{"rP", 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            RowBox[{"P", "/", "k"}]}], ")"}], "\n", "      ", "P", 
          RowBox[{"(", "t0", ")"}]}], " ", "=", " ", 
         RowBox[{
          RowBox[{
          "p0", "\n", "    ", "The", " ", "solution", " ", "is", "\n", "    ",
            "p", 
           RowBox[{"(", "t", ")"}]}], " ", "=", " ", 
          RowBox[{"kp_", "0", 
           RowBox[{
            RowBox[{"e", "^", 
             RowBox[{"{", 
              RowBox[{"r", 
               RowBox[{"(", 
                RowBox[{"t", "-", "t0"}], ")"}]}], "}"}]}], "/", 
            RowBox[{"(", 
             RowBox[{"k", " ", "+", " ", 
              RowBox[{"p_", "0", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"e", "^", 
                  RowBox[{"{", 
                   RowBox[{"r", 
                    RowBox[{"(", 
                    RowBox[{"t", "-", "t0"}], ")"}]}], "}"}]}], " ", "-", " ",
                  "1"}], ")"}]}]}], ")"}]}], "\[IndentingNewLine]", "We", " ",
            "return", " ", "p", 
           RowBox[{"(", "t1", ")"}]}]}]}]}], "\[IndentingNewLine]", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"k", "*", "p0", "*", 
          RowBox[{"Exp", "[", 
           RowBox[{"r", "*", 
            RowBox[{"(", 
             RowBox[{"t1", "-", "t0"}], ")"}]}], "]"}]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"k", "+", 
          RowBox[{"p0", "*", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"r", "*", 
               RowBox[{"(", 
                RowBox[{"t1", "-", "t0"}], ")"}]}], "]"}], "-", "1"}], 
            ")"}]}]}], ")"}]}], "]"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Single", " ", "peak", " ", "function", "\[IndentingNewLine]", "Here", 
     " ", "we", " ", "normalize", " ", "it", " ", "such", " ", "that", " ", 
     "the", " ", "maximum", " ", "value", " ", "of", " ", "fs"}], " ", "-", 
    RowBox[{"fs", "[", 
     RowBox[{"x", "/", "2"}], "]"}], "-", " ", 
