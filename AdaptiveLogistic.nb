                  RowBox[{"Pff", "*", " ", 
                   RowBox[{"EUFF", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}], "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"1", "-", "Pff"}], ")"}], " ", "*", 
                   RowBox[{"EUNFF", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"pnff", " ", "=", " ", "1"}], ";", "\[IndentingNewLine]", 
