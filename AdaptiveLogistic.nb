               RowBox[{"iutred", " ", "*", 
                RowBox[{"Re", "[", 
                 RowBox[{"fs", "[", 
                  RowBox[{"b", ",", "\[Nu]", ",", "ci", ",", " ", "maxU"}], 
                  "]"}], "]"}]}], " ", "+", 
