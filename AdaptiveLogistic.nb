       RowBox[{"cred", " ", "=", " ", 
        RowBox[{"disen", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"iutred", " ", "=", " ", 
        RowBox[{"disen", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"maxcr", "*", "2"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"ci", "=", "maxcr"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"EUFF", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "1", ",", 
