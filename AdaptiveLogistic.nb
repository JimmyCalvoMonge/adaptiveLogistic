            RowBox[{"csd", "++"}], ",", " ", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"Pff", "=", 
              RowBox[{"Pffs", "[", 
               RowBox[{"[", "csd", "]"}], "]"}]}], ";", "\[IndentingNewLine]",
              "\[IndentingNewLine]", 
             RowBox[{"(*", " ", 
              RowBox[{
              "Evaluating", " ", "the", " ", "expected", " ", "utilities"}], 
              " ", "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"EUFF0", "=", " ", 
              RowBox[{
               RowBox[{"cred", "*", 
                RowBox[{"Re", "[", 
                 RowBox[{"fs", "[", 
                  RowBox[{"b", ",", "\[Nu]", ",", "csd", ",", " ", "maxU"}], 
                  "]"}], "]"}]}], " ", "+", 
               RowBox[{"\[Delta]", 
                RowBox[{"(", 
