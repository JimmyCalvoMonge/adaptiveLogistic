                  RowBox[{"pnff", "*", " ", 
                   RowBox[{"EUNFF", "[", 
                    RowBox[{"[", 
                    RowBox[{"t", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
             ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"EUFF0", ">", "maxu"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"cs", "[", 
                  RowBox[{"[", "t", "]"}], "]"}], "=", "csd"}], ";", 
                RowBox[{"maxu", "=", "EUFF0"}]}]}], "]"}]}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Be", " ", "careful", " ", "with", " ", "this"}], ",", 
            " ", 
            RowBox[{
            "we", " ", "needed", " ", "to", " ", "change", " ", "the", " ", 
