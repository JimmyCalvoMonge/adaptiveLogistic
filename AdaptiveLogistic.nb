         RowBox[{
          RowBox[{"maxu", "=", "0"}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"csd", "=", "1"}], ",", 
            RowBox[{"csd", "\[LessEqual]", 
