Notebook[{
Cell["\<\
In this notebook we use a SIR adaptive behavior model  to study:
- Information delay
- Biosurveillance\
\>", "Text",
 CellChangeTimes->{{3.926681353539954*^9, 3.926681378949813*^9}, {
  3.926681453008581*^9, 3.9266814564704514`*^9}, {3.926681523218298*^9, 
  3.9266815254058657`*^9}},ExpressionUUID->"e4f714e5-ee56-4455-ac78-\
838b8188223c"],

Cell[CellGroupData[{

Cell["The sigmoid function - ", "Subsubsection",
 CellChangeTimes->{{3.920639352136353*^9, 3.9206393617657843`*^9}, {
  3.926704682046385*^9, 3.926704685982864*^9}, {3.926708084066779*^9, 
  3.926708128939583*^9}},ExpressionUUID->"4cfeeec6-800a-420a-b5d8-\
397529a0cb4b"],

Cell["\<\
The challenge with this function is that different parameters attains the max \
at different contact rates. Thus the return to DFE may get stuck in a lower \
contact rate than the initial. \
\>", "Text",
 CellChangeTimes->{{3.926708120840385*^9, 
  3.926708160517407*^9}},ExpressionUUID->"3c6e2a16-158c-468b-8d1d-\
d711d917b7a5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"y", " ", "=", " ", "0.1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x", " ", "=", " ", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", " ", 
  RowBox[{
   RowBox[{"LogisticSigmoid", "[", 
    RowBox[{"y", " ", 
     RowBox[{"(", 
      RowBox[{"t", "-", "x"}], ")"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", 
     RowBox[{"9", "x"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "1"}], "}"}]}]}], "]"}]}], "Input",
