       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"cs", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "=", "maxcr"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Pii", "=", 
          RowBox[{"1", "-", 
           SuperscriptBox["P", "z"]}]}], ",", " ", 
         RowBox[{
