Cell[CellGroupData[{

Cell["SIR behavior solver function - fixed # of contacts", "Subsubsection",
 CellChangeTimes->{{3.7603912142563953`*^9, 3.760391226463447*^9}, {
  3.76039131551674*^9, 3.760391318676724*^9}, {3.766001510557158*^9, 
  3.766001524795535*^9}},ExpressionUUID->"278f3470-4e5b-4720-a93e-\
88632f2dbe07"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"pops_", ",", "dispars_", ",", "cv_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"pops", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"i", "=", 
        RowBox[{"pops", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"r", "=", 
        RowBox[{"pops", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"\[Beta]", "=", 
        RowBox[{"dispars", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"cv", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"ci", "=", 
        RowBox[{"cv", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", 
       RowBox[{"cr", "=", 
        RowBox[{"cv", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"Return", "[", 
      RowBox[{"\[Beta]", " ", "cs", " ", "s", " ", 
       FractionBox[
        RowBox[{"ci", " ", "i"}], 
        RowBox[{
         RowBox[{"cs", " ", "s"}], "+", 
         RowBox[{"ci", " ", "i"}], "+", 
         RowBox[{"cr", " ", "r"}]}]]}], "]"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SIRB", "[", 
   RowBox[{
   "pops_", ",", "poppars_", ",", "dispars_", ",", "cv_", ",", "soltimes_"}], 
   "]"}], ":=", "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pops", " ", "=", " ", 
     RowBox[{"vector", " ", "with", " ", "the", " ", "S"}]}], ",", "I", ",", 
    RowBox[{
    "R", "  ", "initial", " ", "conditions", " ", "of", " ", "the", " ", 
     "system"}], ",", "\[IndentingNewLine]", 
    RowBox[{"poppars", " ", "=", " ", 
     RowBox[{
     "vector", " ", "with", " ", "the", " ", "popualtion", " ", "dynamics", 
      " ", "parameters", " ", "\[CapitalLambda]", " ", "and", " ", 
      "\[Mu]"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"dispars", " ", "=", " ", 
     RowBox[{
     "vector", " ", "with", " ", "the", " ", "disease", " ", "parameters", 
      " ", "\[Beta]", " ", "and", " ", "\[Gamma]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{
     "#", " ", "of", " ", "contacts", " ", "made", " ", "per", " ", "disease",
       " ", "class", " ", "individuals"}]}], ",", "\[IndentingNewLine]", 
    RowBox[{"soltimes", " ", "=", " ", 
     RowBox[{"times", " ", "for", " ", "the", " ", "partial", " ", 
      RowBox[{"solution", "."}]}]}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"s0", "=", 
       RowBox[{"pops", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"i0", "=", 
       RowBox[{"pops", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"r0", "=", 
       RowBox[{"pops", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", " ", 
      RowBox[{"(*", "pops", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[CapitalLambda]", "=", 
       RowBox[{"poppars", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"\[Mu]", "=", 
       RowBox[{"poppars", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
      RowBox[{"(*", "poppars", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"\[Beta]", "=", 
       RowBox[{"dispars", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"\[Gamma]", "=", 
       RowBox[{"dispars", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", " ", 
      RowBox[{"(*", "dispars", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"cs", "=", 
       RowBox[{"cv", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"ci", "=", 
       RowBox[{"cv", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{"cr", "=", 
       RowBox[{"cv", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ",", 
      RowBox[{"(*", "c", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"int", "=", 
       RowBox[{"soltimes", "[", 
        RowBox[{"[", "1", "]"}], "]"}]}], ",", 
      RowBox[{"fint", "=", 
       RowBox[{"soltimes", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", "}"}], ",",
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"s0", "+", "i0", "+", "r0"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"The", " ", "system"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"ds", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"s", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{"\[CapitalLambda]", "-", 
        RowBox[{"B", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", "[", "t", "]"}], ",", 
            RowBox[{"i", "[", "t", "]"}], ",", 
            RowBox[{"r", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Beta]", ",", "\[Gamma]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"cs", ",", "ci", ",", "cr"}], "}"}]}], "]"}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"s", "[", "t", "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"di", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"i", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"B", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"s", "[", "t", "]"}], ",", 
            RowBox[{"i", "[", "t", "]"}], ",", 
            RowBox[{"r", "[", "t", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Beta]", ",", "\[Gamma]"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"cs", ",", "ci", ",", "cr"}], "}"}]}], "]"}], "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Gamma]", "+", "\[Mu]"}], ")"}], " ", 
         RowBox[{"i", "[", "t", "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dr", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "'"}], "[", "t", "]"}], "\[Equal]", 
       RowBox[{
        RowBox[{"\[Gamma]", " ", 
         RowBox[{"i", "[", "t", "]"}]}], "-", 
        RowBox[{"\[Mu]", " ", 
         RowBox[{"r", "[", "t", "]"}]}]}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", " ", 
      RowBox[{"The", " ", "solution"}], " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"solb", "=", 
      RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"NDSolve", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ds", ",", "di", ",", "dr", ",", 
            RowBox[{
             RowBox[{"s", "[", "int", "]"}], "\[Equal]", "s0"}], ",", 
            RowBox[{
             RowBox[{"i", "[", "int", "]"}], "\[Equal]", "i0"}], ",", 
            RowBox[{
             RowBox[{"r", "[", "int", "]"}], "\[Equal]", "r0"}]}], "}"}], ",",
           "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"s", ",", "i", ",", "r"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "int", ",", "fint"}], "}"}], ",", 
          RowBox[{"MaxSteps", "\[Rule]", "10000"}], ",", 
          RowBox[{"PrecisionGoal", "\[Rule]", "5"}]}], "]"}], ",", "1"}], 
       "]"}]}], ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.7603912288805847`*^9, 3.7603912294863777`*^9}, 
   3.760391277085906*^9, {3.760391410188106*^9, 3.760391414428155*^9}, {
