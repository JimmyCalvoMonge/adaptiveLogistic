           RowBox[{"t", ",", "1", ",", 
            RowBox[{"T", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", " ", 
        RowBox[{
        "Vector", " ", "storaging", " ", "the", " ", "optimal", " ", 
         "contact", " ", "rate", " ", "for", " ", "susceptible", " ", 
         "individuals"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"cs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
