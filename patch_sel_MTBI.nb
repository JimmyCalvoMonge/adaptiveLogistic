          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"des", "\[Equal]", "2"}], ",", 
      RowBox[{"curloc", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"curloc", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"curloc", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", "1"}]}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"des", "\[Equal]", "3"}], ",", 
      RowBox[{"curloc", "=", 
       RowBox[{"{", 
